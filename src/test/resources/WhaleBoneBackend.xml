<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="WhaleboneBackend"
       annotations="JDK"
       verbose="1"
       parallel="classes"
       thread-count="3"
       data-provider-thread-count="3"
>
    <test name="WhaleboneBackend" parallel="methods" thread-count="5">
        <groups>
            <dependencies>
                <group name="WhaleBoneE2E" depends-on="WhaleBoneSmoke"/>
            </dependencies>
        </groups>
        <classes>
            <class name="com.walder.at.lib.whalebone.WhaleboneSmokeIT"/>
            <class name="com.walder.at.lib.whalebone.WhaleboneBackendIT" />
        </classes>
    </test>
</suite>
